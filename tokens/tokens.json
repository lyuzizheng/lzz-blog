{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "LZZ Blog Design Tokens",
  "version": "1.0.0",
  "concept": "The Digital Darkroom & Print Atelier",
  "color": {
    "modes": {
      "day": {
        "name": "Daylight Print Atelier",
        "substrate": "#FAFAF7",
        "surface": "#F0F0EB",
        "chamber": "#E9E9E5",
        "dominantInk": {
          "hex": "#2148B8",
          "name": "Cobalt Blue",
          "rgb": [33, 72, 184],
          "share": 0.8
        },
        "accentInk": {
          "hex": "#C65F38",
          "name": "Terracotta Orange",
          "rgb": [198, 95, 56],
          "share": 0.2
        },
        "overprint": "#18224B",
        "text": {
          "primary": "#1C2B54",
          "secondary": "#35477D",
          "muted": "#6B7C9E",
          "badge": "#FAFAF7"
        },
        "border": {
          "default": "rgba(33, 72, 184, 0.25)",
          "strong": "#2148B8"
        },
        "blendMode": "multiply"
      },
      "night": {
        "name": "Safelight Darkroom",
        "substrate": "#0D0E11",
        "surface": "#14151B",
        "chamber": "#181920",
        "dominantInk": {
          "hex": "#E54B4B",
          "name": "Kodak Safelight Red",
          "rgb": [229, 75, 75],
          "share": 0.75
        },
        "accentInk": {
          "hex": "#F3E8D6",
          "name": "Luminescent Cream",
          "rgb": [243, 232, 214],
          "share": 0.25
        },
        "overprint": "#FF5A5A",
        "text": {
          "primary": "#F3E8D6",
          "secondary": "rgba(243, 232, 214, 0.82)",
          "muted": "rgba(243, 232, 214, 0.55)",
          "badge": "#0D0E11"
        },
        "border": {
          "default": "rgba(229, 75, 75, 0.35)",
          "strong": "#E54B4B"
        },
        "blendMode": "screen"
      }
    }
  },
  "typography": {
    "fonts": {
      "display": "'Newsreader', 'Playfair Display', 'Cormorant', serif",
      "body": "'Geist', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
      "telemetry": "'Geist Mono', 'JetBrains Mono', 'SF Mono', monospace"
    },
    "scale": {
      "displayXXL": {
        "fontSize": "clamp(4.5rem, 9vw, 9.5rem)",
        "lineHeight": 0.92,
        "letterSpacing": "-0.03em",
        "fontWeight": 900
      },
      "displayXL": {
        "fontSize": "clamp(2.75rem, 5vw, 5rem)",
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em",
        "fontWeight": 800
      },
      "h1": {
        "fontSize": "2.25rem",
        "lineHeight": 1.15,
        "letterSpacing": "-0.015em",
        "fontWeight": 700
      },
      "h2": {
        "fontSize": "1.5rem",
        "lineHeight": 1.25,
        "letterSpacing": "-0.01em",
        "fontWeight": 600
      },
      "body": {
        "fontSize": "1.0625rem",
        "lineHeight": 1.75,
        "fontWeight": 400
      },
      "caption": {
        "fontSize": "0.875rem",
        "lineHeight": 1.5,
        "fontWeight": 400
      },
      "telemetry": {
        "fontSize": "0.75rem",
        "lineHeight": 1.4,
        "letterSpacing": "0.08em",
        "fontWeight": 700,
        "fontVariantNumeric": "tabular-nums"
      }
    }
  },
  "physics": {
    "lenis": {
      "lerp": 0.08,
      "duration": 1.2,
      "smoothWheel": true,
      "wheelMultiplier": 0.9,
      "touchMultiplier": 1.5
    },
    "springs": {
      "snappy": {
        "stiffness": 450,
        "damping": 30,
        "mass": 0.8
      },
      "trayFloat": {
        "stiffness": 220,
        "damping": 24,
        "mass": 1.2
      },
      "cursorTrack": {
        "stiffness": 150,
        "damping": 18,
        "mass": 0.6
      },
      "dossierDrawer": {
        "stiffness": 300,
        "damping": 32,
        "mass": 1.0
      }
    }
  },
  "film": {
    "grainOpacity": 0.045,
    "halftoneDotSize": "12px",
    "registrationDriftMm": 1.5
  }
}
