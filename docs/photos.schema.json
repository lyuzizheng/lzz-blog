{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "../docs/photos.schema.json",
  "title": "LZZ Darkroom photo dataset (content/photos.json)",
  "type": "object",
  "required": ["photos"],
  "properties": {
    "photos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "frame", "alt", "width", "height", "chemistry", "exif"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "frame": { "type": "string", "minLength": 1 },
          "alt": { "type": "string", "minLength": 1 },
          "src": { "type": "string", "description": "Served file, e.g. /darkroom/sg-night.avif. Absent → SVG specimen plate." },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "chemistry": { "type": "string", "minLength": 1 },
          "exif": {
            "type": "object",
            "required": ["camera", "lens", "focal", "aperture", "shutter", "iso", "takenAt"],
            "properties": {
              "camera": { "type": "string" },
              "lens": { "type": "string" },
              "focal": { "type": "string" },
              "aperture": { "type": "string" },
              "shutter": { "type": "string" },
              "iso": { "type": "string" },
              "takenAt": { "type": "string" },
              "gps": { "type": "string" },
              "ev": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
