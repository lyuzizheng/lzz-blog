    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "unist-util-visit": "^5.1.0",
    "velite": "^0.4.0",
    "wrangler": "^4.129.0"
  }
