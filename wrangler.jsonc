{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lzz-blog",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "cache": {
    // Do NOT set cross_version_cache: it persists caches.default across
    // deploys, and OpenNext's cache interception + regional incremental
    // cache live there — stale HTML would survive every deploy.
    "enabled": true
  },
  "routes": [
    {
      "pattern": "www.brabalawuka.cc",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
