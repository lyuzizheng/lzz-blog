# ==============================================================================
# Cloudflare Workers Static Assets Headers Configuration
# Enforces aggressive HTTP edge and client-side caching for immutable static assets.
# ==============================================================================

# Next.js fingerprinted immutable assets (JS chunks, CSS, media, fonts)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable


# Post content images (covers + figures synced from content/posts)
/posts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Static photo assets, post illustrations, and darkroom media
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Avatar image (explicit MIME + stale-while-revalidate caching)
/avatar.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Product screenshots and mockups
/products/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Career Dossier PDF asset
/resume.pdf
  Content-Type: application/pdf
  Content-Disposition: inline; filename="Lyu_Zizheng_Resume.pdf"
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# AI/LLM Search Crawlers Knowledge Bases
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Web crawler instructions
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
